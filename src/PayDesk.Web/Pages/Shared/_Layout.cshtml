<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PayDesk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --pd-primary: #184c78;
            --pd-primary-hover: #133c5e;
            --pd-secondary: #f0f4f8;
        }
        .navbar-paydesk {
            background-color: var(--pd-primary);
        }
        .navbar-paydesk .navbar-brand,
        .navbar-paydesk .nav-link {
            color: #ffffff;
        }
        .navbar-paydesk .nav-link:hover {
            color: #cbd5e1;
        }
        .btn-paydesk {
            background-color: var(--pd-primary);
            color: white;
        }
        .btn-paydesk:hover {
            background-color: var(--pd-primary-hover);
            color: white;
        }
        .card-header-paydesk {
            background-color: var(--pd-secondary);
            border-bottom: 2px solid #d0dbe5;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-paydesk shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-page="/Index">
                    <i class="bi bi-wallet2"></i> PayDesk
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Status"><i class="bi bi-activity"></i> Status</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock"></i> Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Admin/Consolidation"><i class="bi bi-gear-wide-connected"></i> Monthly Consolidation</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Users"><i class="bi bi-people"></i> User Management</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3 text-white">
                                <i class="bi bi-person-circle"></i>
                                <span class="fw-semibold">@User.Identity.Name</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-warning text-dark ms-1">Admin</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Sign Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Sign In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container flex-grow-1 mb-5">
        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-white text-muted mt-auto">
        <div class="container text-center small">
            &copy; 2026 PayDesk - Expense Management & Reimbursement System | Powered by .NET 10 & PostgreSQL
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
